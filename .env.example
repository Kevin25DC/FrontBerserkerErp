# URL de la API (servidor a servidor; el navegador nunca la ve)
API_URL=http://127.0.0.1:8100/api/v1
# Token compartido con la API para el servicio de PDF (adjuntos de correo/WhatsApp).
# Debe ser igual a PDF_SERVICE_TOKEN de la API.
PDF_SERVICE_TOKEN=genera-un-token-largo
# Solo local: ruta de Chrome si no está en la ubicación estándar (en Vercel se usa @sparticuz/chromium)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
